{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "portable-pi manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "pi", "node", "paths", "isolation", "skills"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "usbLabel": { "type": "string", "maxLength": 11 },
    "pi": {
      "type": "object",
      "required": ["version", "entrypoint", "runtimePackages", "launchArgs"],
      "properties": {
        "version": { "type": "string" },
        "entrypoint": { "type": "string" },
        "runtimePackages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version", "keep"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "keep": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string" }
            }
          }
        },
        "optionalPackages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "enabled"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "enabled": { "type": "boolean" },
              "reason": { "type": "string" }
            }
          }
        },
        "launchArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "node": {
      "type": "object",
      "required": ["version", "targets"],
      "properties": {
        "version": { "type": "string" },
        "flavor": { "type": "string" },
        "enginesFloor": { "type": "string" },
        "checksums": { "type": "string" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "archive", "url", "installDir", "nodeBin"],
            "properties": {
              "id": { "type": "string" },
              "archive": { "type": "string" },
              "url": { "type": "string" },
              "installDir": { "type": "string" },
              "nodeBin": { "type": "string" },
              "npmBin": { "type": "string" }
            }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "portableGit": {
          "type": "object",
          "required": ["version", "file", "url", "installDir", "pathEntries"],
          "properties": {
            "version": { "type": "string" },
            "file": { "type": "string" },
            "url": { "type": "string" },
            "sizeMb": { "type": "number" },
            "installDir": { "type": "string" },
            "pathEntries": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "required": ["agentDir", "sessionDir", "skillsDir", "tempDir", "runtimeDir"],
      "additionalProperties": { "type": "string" }
    },
    "isolation": {
      "type": "object",
      "required": ["env"],
      "properties": {
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "notOverridden": { "type": "object", "additionalProperties": { "type": "string" } },
        "guarantees": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skills": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "root", "path"],
            "properties": {
              "name": { "type": "string" },
              "root": { "type": "string", "enum": ["agent", "agents", "npm"] },
              "path": { "type": "string" },
              "reason": { "type": "string" },
              "caveat": { "type": "string" },
              "sizeMb": { "type": "number" }
            }
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
